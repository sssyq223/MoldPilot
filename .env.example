AGENT_DATABASE_URL=postgresql+psycopg://postgres:REPLACE_ME@127.0.0.1:5432/moldpilot
AGENT_MIGRATION_URL=postgresql+psycopg://postgres:REPLACE_ME@127.0.0.1:5432/moldpilot
# Legacy MoldPilot installs may keep MOLD_MIGRATION_URL; AGENT_MIGRATION_URL takes precedence.
AGENT_RESTORE_DATABASE_URL=postgresql+psycopg://postgres:REPLACE_ME@127.0.0.1:5432/moldpilot_restore
MOLD_TEST_DATABASE_URL=postgresql+psycopg://postgres:REPLACE_ME@127.0.0.1:5432/moldpilot_test
# Optional explicit PostgreSQL client executable paths when pg_dump/pg_restore are not on PATH.
AGENT_PG_DUMP_PATH=
AGENT_PG_RESTORE_PATH=
AGENT_PG_CLIENT_IMAGE=postgres:18-alpine
AGENT_ACCEPTANCE_EVIDENCE_FILE=.local/acceptance-gates.json
AGENT_ORIGIN=http://127.0.0.1:5173
AGENT_COOKIE_SECURE=false
AGENT_ENVIRONMENT=development
AGENT_WORKER_SECRET=REPLACE_WITH_A_RANDOM_LOCAL_SECRET
AGENT_API_BASE_URL=http://127.0.0.1:8000

# Runtime retention policy. Zero means not yet confirmed; set explicit days before delivery.
AGENT_AUDIT_LOG_RETENTION_DAYS=0
AGENT_APP_LOG_RETENTION_DAYS=0
AGENT_ACCESS_LOG_RETENTION_DAYS=0
AGENT_MODEL_LOG_RETENTION_DAYS=0

# Mold-domain logistics quote validity policy. Override per deployment after business confirmation.
MOLD_LOGISTICS_QUOTE_MAX_VALID_DAYS=183
MOLD_ERP_BASE_URL=
MOLD_ERP_ALLOW_INSECURE_LOCAL=false
MOLD_CREDENTIAL_ENCRYPTION_KEY=
# Optional override; blank uses backend/domain_packs/mold/mcp/erp-design-upload.
MOLD_ERP_DESIGN_MCP_ROOT=
# Path to the ERP-produced MCP package/tarball used by `npm run setup` in that directory.
MOLD_ERP_DESIGN_MCP_PACKAGE=

AGENT_LLM_ENABLED=false
AGENT_LLM_PROVIDER=company
# 本机临时模型：设置 provider=ollama，按实际端口修改；公司接口配置保留。
AGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
AGENT_OLLAMA_MODEL=deepseek-r1:7b
AGENT_LLM_BASE_URL=https://llm.example.com/v1
# Only set this when explicitly allowing one exact private HTTP origin.
AGENT_LLM_TRUSTED_HTTP_ORIGIN=
AGENT_LLM_MODEL=Qwen3-30B-A3B-Instruct
AGENT_LLM_API_KEY=
# Blank means no explicit HTTP proxy; a host TUN may still intercept traffic.
AGENT_LLM_PROXY_URL=
# TLS settings apply only when an HTTPS model endpoint is configured.
AGENT_LLM_TLS_KEY_EXCHANGE=auto
AGENT_LLM_TLS_MAX_VERSION=auto
AGENT_LLM_CONNECT_TIMEOUT=20
AGENT_LLM_READ_TIMEOUT=60
AGENT_LLM_MAX_OUTPUT_TOKENS=2048
AGENT_REDIS_URL=redis://127.0.0.1:6379/0
AGENT_REDIS_HOME=D:\Redis
AGENT_BUSINESS_PACK=mold

# File storage is environment-specific:
# - development/test: local files under .local/files (ignored by Git)
# - production/staging: private, versioned S3-compatible storage only
AGENT_FILE_BACKEND=local
AGENT_FILE_LOCAL_ROOT=.local/files
AGENT_FILE_MAX_BYTES=20971520
AGENT_FILE_DAILY_BYTES=209715200
AGENT_FILE_S3_ENDPOINT=
AGENT_FILE_S3_BUCKET=
AGENT_FILE_S3_REGION=us-east-1
AGENT_FILE_S3_ACCESS_KEY=
AGENT_FILE_S3_SECRET_KEY=

# Production/staging example (put these in the deployment secret environment,
# do not commit real credentials):
# AGENT_ENVIRONMENT=production
# AGENT_COOKIE_SECURE=true
# AGENT_FILE_BACKEND=s3
# AGENT_FILE_S3_ENDPOINT=https://s3.example.com
# AGENT_FILE_S3_BUCKET=moldpilot-prod-files
# AGENT_FILE_S3_REGION=us-east-1
# AGENT_FILE_S3_ACCESS_KEY=REPLACE_WITH_SECRET
# AGENT_FILE_S3_SECRET_KEY=REPLACE_WITH_SECRET
