MOLD_DATABASE_URL=postgresql+psycopg://postgres:REPLACE_ME@127.0.0.1:5432/moldpilot
MOLD_MIGRATION_URL=postgresql+psycopg://postgres:REPLACE_ME@127.0.0.1:5432/moldpilot
MOLD_RESTORE_DATABASE_URL=postgresql+psycopg://postgres:REPLACE_ME@127.0.0.1:5432/moldpilot_restore
MOLD_TEST_DATABASE_URL=postgresql+psycopg://postgres:REPLACE_ME@127.0.0.1:5432/moldpilot_test
# Optional explicit PostgreSQL client executable paths when pg_dump/pg_restore are not on PATH.
MOLD_PG_DUMP_PATH=
MOLD_PG_RESTORE_PATH=
MOLD_PG_CLIENT_IMAGE=postgres:18-alpine
MOLD_ACCEPTANCE_EVIDENCE_FILE=.local/acceptance-gates.json
MOLD_ORIGIN=http://127.0.0.1:5173
MOLD_COOKIE_SECURE=false
MOLD_WORKER_SECRET=REPLACE_WITH_A_RANDOM_LOCAL_SECRET
MOLD_API_BASE_URL=http://127.0.0.1:8000

# Runtime retention policy. Zero means not yet confirmed; set explicit days before delivery.
MOLD_AUDIT_LOG_RETENTION_DAYS=0
MOLD_APP_LOG_RETENTION_DAYS=0
MOLD_ACCESS_LOG_RETENTION_DAYS=0
MOLD_MODEL_LOG_RETENTION_DAYS=0

MOLD_LLM_ENABLED=false
MOLD_LLM_PROVIDER=company
# 本机临时模型：设置 provider=ollama，按实际端口修改；公司接口配置保留。
MOLD_OLLAMA_BASE_URL=http://127.0.0.1:11434
MOLD_OLLAMA_MODEL=deepseek-r1:7b
MOLD_LLM_BASE_URL=https://llm.example.com/v1
# Only set this when explicitly allowing one exact private HTTP origin.
MOLD_LLM_TRUSTED_HTTP_ORIGIN=
MOLD_LLM_MODEL=Qwen3-30B-A3B-Instruct
MOLD_LLM_API_KEY=
# Blank means no explicit HTTP proxy; a host TUN may still intercept traffic.
MOLD_LLM_PROXY_URL=
# TLS settings apply only when an HTTPS model endpoint is configured.
MOLD_LLM_TLS_KEY_EXCHANGE=auto
MOLD_LLM_TLS_MAX_VERSION=auto
MOLD_LLM_CONNECT_TIMEOUT=10
MOLD_LLM_READ_TIMEOUT=60
MOLD_LLM_MAX_OUTPUT_TOKENS=2048
MOLD_REDIS_URL=redis://127.0.0.1:6379/0
MOLD_REDIS_HOME=D:\Redis

# Private files: local is development/test only; production requires a private versioned S3 bucket.
MOLD_FILE_BACKEND=local
MOLD_FILE_LOCAL_ROOT=.local/files
MOLD_FILE_MAX_BYTES=20971520
MOLD_FILE_DAILY_BYTES=209715200
MOLD_FILE_S3_ENDPOINT=
MOLD_FILE_S3_BUCKET=
MOLD_FILE_S3_REGION=us-east-1
MOLD_FILE_S3_ACCESS_KEY=
MOLD_FILE_S3_SECRET_KEY=
