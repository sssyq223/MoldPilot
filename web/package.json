  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:mold",
    "build:mold": "vue-tsc --noEmit -p tsconfig.mold.json && vite build",
    "build:template": "vue-tsc --noEmit -p tsconfig.template.json && vite build --mode template",
    "typecheck": "vue-tsc --noEmit -p tsconfig.mold.json && vue-tsc --noEmit -p tsconfig.template.json",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run"
  },
  "dependencies": {
    "bpmn-js": "^18.6.1",
    "dxf-viewer": "^1.0.48",
