    "vue": "3.5.26",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/three": "^0.161.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "^5.8.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.0"
